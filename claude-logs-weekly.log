{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nw3V3hAr1ZGTSbQihdC5Ky","type":"tool_result","content":"1\t\"\"\"\n2\tCoordinate-descent parameter sweep across TRAILING_STOP, sec_insiders filters,\n3\tposition sizing, and WHEEL settings.\n4\t\n5\tScoring is grounded in real historical trade data (the ~34 actual TRAILING_STOP\n6\tpositions in logs/trades.log, replayed against real historical daily bars under\n7\teach candidate's parameters) — that's the primary ranking signal. A broader\n8\tSEC EDGAR historical-signal replay and a Black-Scholes WHEEL premium estimate\n9\tare computed alongside as corroborating evidence and reported separately,\n10\tnever blended into the primary score (real trades vs. synthetic replay differ\n11\ttoo much in sample composition for one number to be meaningful).\n12\t\"\"\"\n13\timport json\n14\timport random\n15\tfrom datetime import date, timedelta\n16\tfrom pathlib import Path\n17\t\n18\tfrom core.alpaca import get_bars_range\n19\tfrom backtest.real_trades import parse_trades_log, build_positions\n20\tfrom backtest.replay import simulate_trailing_stop\n21\tfrom backtest.wheel_replay import simulate_wheel_cycle\n22\tfrom backtest.buckets import bucket_by_month, worst_bucket_pnl, all_buckets_positive\n23\tfrom backtest.signals import filter_signals, fetch_historical_insider_signals\n24\tfrom backtest.trend import prefetch_sma_bars, sma_as_of\n25\t\n26\tSETTINGS_FILE = Path(__file__).parent.parent / \"config\" / \"settings.json\"\n27\t\n28\tLADDER_BUYS_DEFAULT = [{\"drop_pct\": 0.2, \"shares\": 10}, {\"drop_pct\": 0.3, \"shares\": 20}]\n29\t\n30\tPARAM_GRID = {\n31\t    \"trailing_stop.initial_stop_pct\":       [0.05, 0.07, 0.08, 0.10, 0.12, 0.15],\n32\t    \"trailing_stop.trailing_pct\":           [0.03, 0.05, 0.06, 0.08, 0.10],\n33\t    \"trailing_stop.take_profit_pct\":        [0.05, 0.06, 0.08, 0.10, 0.12],\n34\t    \"trailing_stop.profit_target_pct\":      [0.0, 0.02, 0.03, 0.05],\n35\t    \"trailing_stop.ladder_buys_enabled\":    [True, False],\n36\t    \"position_size_usd\":                    [3000, 5000, 8000, 10000],\n37\t    \"min_entry_price\":                      [0, 5, 10, 20, 50],\n38\t    \"trend_filter_sma_days\":                [0, 10, 20, 50],\n39\t    \"sec_insiders.min_transaction_value\":    [100_000, 150_000, 250_000, 500_000],\n40\t    \"sec_insiders.require_high_conviction\":  [True, False],\n41\t    \"wheel.put_otm_pct\":                    [0.03, 0.05, 0.07, 0.10],\n42\t    \"wheel.call_otm_pct\":                   [0.03, 0.05, 0.07, 0.10],\n43\t    \"wheel.profit_close_pct\":               [0.3, 0.5, 0.7],\n44\t    \"wheel.weeks_to_expiry\":                [1, 2, 3],\n45\t}\n46\t\n47\t\n48\tdef _load_base_config() -> dict:\n49\t    with open(SETTINGS_FILE) as f:\n50\t        return json.load(f)\n51\t\n52\t\n53\tdef candidate_from_base(base: dict) -> dict:\n54\t    return {\n55\t        \"trailing_stop.initial_stop_pct\": base[\"trailing_stop\"][\"initial_stop_pct\"],\n56\t        \"trailing_stop.trailing_pct\": base[\"trailing_stop\"][\"trailing_pct\"],\n57\t        \"trailing_stop.take_profit_pct\": base[\"trailing_stop\"][\"take_profit_pct\"],\n58\t        \"trailing_stop.profit_target_pct\": base[\"trailing_stop\"][\"profit_target_pct\"],\n59\t        \"trailing_stop.ladder_buys_enabled\": bool(base[\"trailing_stop\"].get(\"ladder_buys\")),\n60\t        \"position_size_usd\": base.get(\"analyze\", {}).get(\"max_position_usd\", 10000),\n61\t        # No live equivalent today — the investigation's strongest finding was that\n62\t        # post-migration losses cluster in thin, sub-$20 micro-caps, so this is\n63\t        # swept from 0 (no filter, matching current behavior) upward.\n64\t        \"min_entry_price\": 0,\n65\t        \"trend_filter_sma_days\": base.get(\"analyze\", {}).get(\"trend_filter_sma_days\", 0),\n66\t        \"sec_insiders.min_transaction_value\": base[\"sec_insiders\"][\"min_transaction_value\"],\n67\t        \"sec_insiders.require_high_conviction\": base[\"sec_insiders\"][\"require_high_conviction\"],\n68\t        \"wheel.put_otm_pct\": base[\"wheel\"][\"put_otm_pct\"],\n69\t        \"wheel.call_otm_pct\": base[\"wheel\"][\"call_otm_pct\"],\n70\t        \"wheel.profit_close_pct\": base[\"wheel\"][\"profit_close_pct\"],\n71\t        \"wheel.weeks_to_expiry\": base[\"wheel\"][\"weeks_to_expiry\"],\n72\t    }\n73\t\n74\t\n75\tdef candidate_to_cfgs(candidate: dict) -> tuple[dict, dict, float]:\n76\t    ts_cfg = {\n77\t        \"initial_stop_pct\": candidate[\"trailing_stop.initial_stop_pct\"],\n78\t        \"trailing_pct\": candidate[\"trailing_stop.trailing_pct\"],\n79\t        \"take_profit_pct\": candidate[\"trailing_stop.take_profit_pct\"],\n80\t        \"profit_target_pct\": candidate[\"trailing_stop.profit_target_pct\"],\n81\t        \"trailing_pct_from_profit\": candidate[\"trailing_stop.trailing_pct\"],\n82\t        \"ladder_buys\": LADDER_BUYS_DEFAULT if candidate[\"trailing_stop.ladder_buys_enabled\"] else [],\n83\t    }\n84\t    wheel_cfg = {\n85\t        \"put_otm_pct\": candidate[\"wheel.put_otm_pct\"],\n86\t        \"call_otm_pct\": candidate[\"wheel.call_otm_pct\"],\n87\t        \"profit_close_pct\": candidate[\"wheel.profit_close_pct\"],\n88\t        \"weeks_to_expiry\": candidate[\"wheel.weeks_to_expiry\"],\n89\t    }\n90\t    return ts_cfg, wheel_cfg, candidate[\"position_size_usd\"]\n91\t\n92\t\n93\tdef candidate_diff(candidate: dict, base: dict) -> dict:\n94\t    return {k: v for k, v in candidate.items() if base.get(k) != v}\n95\t\n96\t\n97\t# ── Bar prefetch (once per sweep run — reused across every candidate) ────────\n98\t\n99\tdef _prefetch_bars(keys: list[tuple[str, date]], days_forward: int = 180) -> dict:\n100\t    cache = {}\n101\t    for symbol, start in keys:\n102\t        if (symbol, start) in cache:\n103\t            continue\n104\t        end = min(date.today(), start + timedelta(days=days_forward))\n105\t        try:\n106\t            cache[(symbol, start)] = get_bars_range(symbol, start, end)\n107\t        except Exception:\n108\t            cache[(symbol, start)] = []\n109\t    return cache\n110\t\n111\t\n112\t# ── Per-evidence-source scoring ───────────────────────────────────────────────\n113\t\n114\tdef _score_trailing_stop(positions: list[dict], bars_cache: dict, ts_cfg: dict, position_size_usd: float, min_entry_price: float = 0, sma_bars_cache: dict | None = None, trend_filter_sma_days: int = 0) -> dict:\n115\t    records = []\n116\t    for pos in positions:\n117\t        symbol, start = pos[\"symbol\"], pos[\"first_buy_date\"]\n118\t        entry_price = pos[\"buys\"][0][\"price\"]\n119\t        if entry_price < min_entry_price:\n120\t            continue\n121\t        if trend_filter_sma_days > 0 and sma_bars_cache is not None:\n122\t            sma = sma_as_of(sma_bars_cache.get((symbol, start)), start, trend_filter_sma_days)\n123\t            if sma is not None and entry_price < sma:\n124\t                continue\n125\t        bars = bars_cache.get((symbol, start))\n126\t        if not bars:\n127\t            continue\n128\t        result = simulate_trailing_stop(symbol, start, entry_price, ts_cfg, position_size_usd, bars=bars)\n129\t        if result is None:\n130\t            continue\n131\t        records.append({\n132\t            \"symbol\": symbol, \"pnl\": result[\"pnl_usd\"], \"exit_date\": result[\"exit_date\"],\n133\t            \"exit_reason\": result[\"exit_reason\"], \"is_open\": result[\"is_open\"],\n134\t        })\n135\t    buckets = bucket_by_month(records, \"exit_date\")\n136\t    return {\n137\t        \"records\": records, \"buckets\": buckets,\n138\t        \"worst_month_pnl\": worst_bucket_pnl(buckets),\n139\t        \"total_pnl\": sum(r[\"pnl\"] for r in records),\n140\t        \"n_trades\": len(records),\n141\t        \"all_positive\": all_buckets_positive(buckets),\n142\t    }\n143\t\n144\t\n145\tdef _score_edgar_replay(signals_raw, bars_cache, ts_cfg, position_size_usd, min_transaction_value, require_high_conviction, min_entry_price: float = 0, sma_bars_cache: dict | None = None, trend_filter_sma_days: int = 0) -> dict | None:\n146\t    if not signals_raw:\n147\t        return None\n148\t    filtered = filter_signals(signals_raw, min_transaction_value, require_high_conviction)\n149\t    records = []\n150\t    for sig in filtered:\n151\t        symbol = sig[\"asset\"][\"ticker\"]\n152\t        try:\n153\t            # publishedDate (filing date) is when the bot could actually see this\n154\t            # signal — txDate is the insider's own transaction date, which can be\n155\t            # up to 2 business days earlier. Entry price also comes from real\n156\t            # market bars, never the Form 4-reported per-share price: the bot\n157\t            # always buys at the current market price via market_buy(), and an\n158\t            # insider's reported price can reflect a negotiated/restricted-stock\n159\t            # price wildly different from the market (confirmed empirically —\n160\t            # e.g. one filing reported $0.80 for a stock trading at $13.28).\n161\t            entry_date = date.fromisoformat(sig[\"publishedDate\"])\n162\t        except (ValueError, KeyError):\n163\t            continue\n164\t        bars = bars_cache.get((symbol, entry_date))\n165\t        if not bars:\n166\t            continue\n167\t        entry_price = float(bars[0].close)\n168\t        if entry_price < max(min_entry_price, 0.01):\n169\t            continue\n170\t        if trend_filter_sma_days > 0 and sma_bars_cache is not None:\n171\t            sma = sma_as_of(sma_bars_cache.get((symbol, entry_date)), entry_date, trend_filter_sma_days)\n172\t            if sma is not None and entry_price < sma:\n173\t                continue\n174\t        result = simulate_trailing_stop(symbol, entry_date, entry_price, ts_cfg, position_size_usd, bars=bars)\n175\t        if result is None:\n176\t            continue\n177\t        records.append({\n178\t            \"symbol\": symbol, \"pnl\": result[\"pnl_usd\"], \"exit_date\": result[\"exit_date\"],\n179\t            \"exit_reason\": result[\"exit_reason\"], \"is_open\": result[\"is_open\"],\n180\t        })\n181\t    buckets = bucket_by_month(records, \"exit_date\")\n182\t    return {\n183\t        \"records\": records, \"buckets\": buckets,\n184\t        \"worst_month_pnl\": worst_bucket_pnl(buckets),\n185\t        \"total_pnl\": sum(r[\"pnl\"] for r in records),\n186\t        \"n_trades\": len(records),\n187\t        \"all_positive\": all_buckets_positive(buckets),\n188\t        \"n_filtered_from\": len(signals_raw),\n189\t    }\n190\t\n191\t\n192\tdef _score_wheel(universe: list[tuple[str, date]], bars_cache: dict, wheel_cfg: dict) -> dict:\n193\t    records = []\n194\t    for symbol, start in universe:\n195\t        bars = bars_cache.get((symbol, start))\n196\t        result = simulate_wheel_cycle(symbol, start, wheel_cfg, bars=bars)\n197\t        for c in result[\"cycles\"]:\n198\t            records.append({\"symbol\": symbol, \"pnl\": c[\"pnl\"], \"exit_date\": c[\"date\"]})\n199\t    buckets = bucket_by_month(records, \"exit_date\")\n200\t    return {\n201\t        \"records\": records, \"buckets\": buckets,\n202\t        \"worst_month_pnl\": worst_bucket_pnl(buckets),\n203\t        \"total_pnl\": sum(r[\"pnl\"] for r in records),\n204\t        \"n_trades\": len(records),\n205\t        \"all_positive\": all_buckets_positive(buckets),\n206\t    }\n207\t\n208\t\n209\t# ── Sweep driver ───────────────────────────────────────────────────────────────\n210\t\n211\tdef run_sweep(\n212\t    max_iterations: int = 200,\n213\t    edgar_start: date | None = None,\n214\t    edgar_end: date | None = None,\n215\t    use_edgar_cache: bool = True,\n216\t    seed: int = 42,\n217\t    target_passing: int = 3,\n218\t    progress_cb=None,\n219\t) -> dict:\n220\t    rng = random.Random(seed)\n221\t    base = _load_base_config()\n222\t    current = candidate_from_base(base)\n223\t\n224\t    positions = [p for p in build_positions(parse_trades_log()) if p[\"buys\"]]\n225\t\n226\t    bars_cache = _prefetch_bars([(p[\"symbol\"], p[\"first_buy_date\"]) for p in positions])\n227\t    sma_keys = [(p[\"symbol\"], p[\"first_buy_date\"]) for p in positions]\n228\t\n229\t    signals_raw = []\n230\t    edgar_bars_cache = {}\n231\t    if edgar_start and edgar_end:\n232\t        signals_raw = fetch_historical_insider_signals(edgar_start, edgar_end, use_cache=use_edgar_cache)\n233\t        # Prefetch bars for the loosest possible filter so every candidate's\n234\t        # (tighter) filtered subset is already covered by the cache.\n235\t        loosest = filter_signals(signals_raw, min_transaction_value=50_000, require_high_conviction=False)\n236\t        keys = []\n237\t        for sig in loosest:\n238\t            try:\n239\t                keys.append((sig[\"asset\"][\"ticker\"], date.fromisoformat(sig[\"publishedDate\"])))\n240\t            except (ValueError, KeyError):\n241\t                continue\n242\t        edgar_bars_cache = _prefetch_bars(keys)\n243\t        sma_keys += keys\n244\t\n245\t    # One SMA bar-window prefetch (up to the largest trend_filter_sma_days in the\n246\t    # grid) covers every candidate's smaller-window SMA too — sliced from the same cache.\n247\t    sma_bars_cache = prefetch_sma_bars(sma_keys)\n248\t\n249\t    wheel_universe = list({(p[\"symbol\"], p[\"first_buy_date\"]) for p in positions})\n250\t    wheel_bars_cache = _prefetch_bars(wheel_universe, days_forward=120)\n251\t\n252\t    def evaluate(candidate: dict) -> dict:\n253\t        ts_cfg, wheel_cfg, pos_size = candidate_to_cfgs(candidate)\n254\t        min_entry_price = candidate[\"min_entry_price\"]\n255\t        trend_filter_sma_days = candidate[\"trend_filter_sma_days\"]\n256\t        real_result = _score_trailing_stop(\n257\t            positions, bars_cache, ts_cfg, pos_size, min_entry_price,\n258\t            sma_bars_cache, trend_filter_sma_days,\n259\t        )\n260\t        edgar_result = _score_edgar_replay(\n261\t            signals_raw, edgar_bars_cache, ts_cfg, pos_size,\n262\t            candidate[\"sec_insiders.min_transaction_value\"],\n263\t            candidate[\"sec_insiders.require_high_conviction\"],\n264\t            min_entry_price, sma_bars_cache, trend_filter_sma_days,\n265\t        )\n266\t        wheel_result = _score_wheel(wheel_universe, wheel_bars_cache, wheel_cfg)\n267\t\n268\t        passes_strict = real_result[\"all_positive\"] and (edgar_result is None or edgar_result[\"all_positive\"])\n269\t        return {\n270\t            \"candidate\": dict(candidate),\n271\t            \"real_trades\": real_result,\n272\t            \"edgar_replay\": edgar_result,\n273\t            \"wheel_estimate\": wheel_result,\n274\t            \"score\": (real_result[\"worst_month_pnl\"], real_result[\"total_pnl\"]),\n275\t            \"passes_strict\": passes_strict,\n276\t        }\n277\t\n278\t    best = evaluate(current)\n279\t    all_results = [best]\n280\t    passing = [best] if best[\"passes_strict\"] else []\n281\t\n282\t    axes = list(PARAM_GRID.keys())\n283\t    iterations = 0\n284\t    while iterations < max_iterations and len(passing) < target_passing:\n285\t        axis = rng.choice(axes)\n286\t        trial = dict(current)\n287\t        trial[axis] = rng.choice(PARAM_GRID[axis])\n288\t        iterations += 1\n289\t        if trial == current:\n290\t            continue\n291\t\n292\t        result = evaluate(trial)\n293\t        all_results.append(result)\n294\t\n295\t        if result[\"score\"] > best[\"score\"]:\n296\t            best = result\n297\t            current = trial\n298\t        if result[\"passes_strict\"]:\n299\t            passing.append(result)\n300\t\n301\t        if progress_cb:\n302\t            progress_cb(iterations, max_iterations, best, len(passing))\n303\t\n304\t    all_results.sort(key=lambda r: r[\"score\"], reverse=True)\n305\t    return {\n306\t        \"iterations\": iterations,\n307\t        \"best\": best,\n308\t        \"passing\": passing,\n309\t        \"leaderboard\": all_results[:20],\n310\t        \"base_candidate\": candidate_from_base(base),\n311\t        \"n_real_positions\": len(positions),\n312\t        \"n_edgar_signals\": len(signals_raw),\n313\t    }\n314\t\n315\t\n316\tif __name__ == \"__main__\":\n317\t    import argparse\n318\t\n319\t    from backtest.report import generate_leaderboard\n320\t\n321\t    parser = argparse.ArgumentParser(description=\"Run the strategy parameter sweep.\")\n322\t    parser.add_argument(\"--iterations\", type=int, default=200)\n323\t    parser.add_argument(\"--edgar-days\", type=int, default=0, help=\"Also replay this many days of historical EDGAR signals (0 = skip)\")\n324\t    parser.add_argument(\"--edgar-end\", type=str, default=None, help=\"YYYY-MM-DD, defaults to today\")\n325\t    parser.add_argument(\"--no-cache\", action=\"store_true\", help=\"Force a fresh EDGAR fetch instead of using backtest/cache/\")\n326\t    parser.add_argument(\"--label\", type=str, default=None, help=\"Label for the output leaderboard/json filenames\")\n327\t    args = parser.parse_args()\n328\t\n329\t    def _progress(i, total, best, n_passing):\n330\t        if i % 10 == 0 or i == total:\n331\t            print(f\"  [{i}/{total}] best worst-month=${best['score'][0]:,.0f} total=${best['score'][1]:,.0f} passing={n_passing}\")\n332\t\n333\t    edgar_start = edgar_end = None\n334\t    if args.edgar_days > 0:\n335\t        edgar_end = date.fromisoformat(args.edgar_end) if args.edgar_end else date.today()\n336\t        edgar_start = edgar_end - timedelta(days=args.edgar_days)\n337\t        print(f\"Will replay historical EDGAR signals {edgar_start} .. {edgar_end}\")\n338\t\n339\t    print(f\"Running parameter sweep (max {args.iterations} iterations)...\")\n340\t    result = run_sweep(\n341\t        max_iterations=args.iterations,\n342\t        edgar_start=edgar_start,\n343\t        edgar_end=edgar_end,\n344\t        use_edgar_cache=not args.no_cache,\n345\t        progress_cb=_progress,\n346\t    )\n347\t    print(f\"\\nDone. {result['iterations']} iterations, {len(result['passing'])} fully-passing candidates found.\")\n348\t    print(f\"Best worst-month P&L: ${result['best']['score'][0]:,.0f} | total: ${result['best']['score'][1]:,.0f}\")\n349\t\n350\t    md_path, json_path = generate_leaderboard(result, label=args.label)\n351\t    print(f\"\\nLeaderboard: {md_path}\")\n352\t    print(f\"Raw results: {json_path}\")\n353\t"}]},"parent_tool_use_id":null,"session_id":"b47eab5f-77a3-4275-b60f-15c5049d3552","uuid":"b0202de8-909e-4e92-9cf7-cb77c5c60569","timestamp":"2026-07-27T16:03:49.505Z","tool_use_result":{"type":"text","file":{"filePath":"/var/projects/llmTrader/backtest/sweep.py","content":"\"\"\"\nCoordinate-descent parameter sweep across TRAILING_STOP, sec_insiders filters,\nposition sizing, and WHEEL settings.\n\nScoring is grounded in real historical trade data (the ~34 actual TRAILING_STOP\npositions in logs/trades.log, replayed against real historical daily bars under\neach candidate's parameters) — that's the primary ranking signal. A broader\nSEC EDGAR historical-signal replay and a Black-Scholes WHEEL premium estimate\nare computed alongside as corroborating evidence and reported separately,\nnever blended into the primary score (real trades vs. synthetic replay differ\ntoo much in sample composition for one number to be meaningful).\n\"\"\"\nimport json\nimport random\nfrom datetime import date, timedelta\nfrom pathlib import Path\n\nfrom core.alpaca import get_bars_range\nfrom backtest.real_trades import parse_trades_log, build_positions\nfrom backtest.replay import simulate_trailing_stop\nfrom backtest.wheel_replay import simulate_wheel_cycle\nfrom backtest.buckets import bucket_by_month, worst_bucket_pnl, all_buckets_positive\nfrom backtest.signals import filter_signals, fetch_historical_insider_signals\nfrom backtest.trend import prefetch_sma_bars, sma_as_of\n\nSETTINGS_FILE = Path(__file__).parent.parent / \"config\" / \"settings.json\"\n\nLADDER_BUYS_DEFAULT = [{\"drop_pct\": 0.2, \"shares\": 10}, {\"drop_pct\": 0.3, \"shares\": 20}]\n\nPARAM_GRID = {\n    \"trailing_stop.initial_stop_pct\":       [0.05, 0.07, 0.08, 0.10, 0.12, 0.15],\n    \"trailing_stop.trailing_pct\":           [0.03, 0.05, 0.06, 0.08, 0.10],\n    \"trailing_stop.take_profit_pct\":        [0.05, 0.06, 0.08, 0.10, 0.12],\n    \"trailing_stop.profit_target_pct\":      [0.0, 0.02, 0.03, 0.05],\n    \"trailing_stop.ladder_buys_enabled\":    [True, False],\n    \"position_size_usd\":                    [3000, 5000, 8000, 10000],\n    \"min_entry_price\":                      [0, 5, 10, 20, 50],\n    \"trend_filter_sma_days\":                [0, 10, 20, 50],\n    \"sec_insiders.min_transaction_value\":    [100_000, 150_000, 250_000, 500_000],\n    \"sec_insiders.require_high_conviction\":  [True, False],\n    \"wheel.put_otm_pct\":                    [0.03, 0.05, 0.07, 0.10],\n    \"wheel.call_otm_pct\":                   [0.03, 0.05, 0.07, 0.10],\n    \"wheel.profit_close_pct\":               [0.3, 0.5, 0.7],\n    \"wheel.weeks_to_expiry\":                [1, 2, 3],\n}\n\n\ndef _load_base_config() -> dict:\n    with open(SETTINGS_FILE) as f:\n        return json.load(f)\n\n\ndef candidate_from_base(base: dict) -> dict:\n    return {\n        \"trailing_stop.initial_stop_pct\": base[\"trailing_stop\"][\"initial_stop_pct\"],\n        \"trailing_stop.trailing_pct\": base[\"trailing_stop\"][\"trailing_pct\"],\n        \"trailing_stop.take_profit_pct\": base[\"trailing_stop\"][\"take_profit_pct\"],\n        \"trailing_stop.profit_target_pct\": base[\"trailing_stop\"][\"profit_target_pct\"],\n        \"trailing_stop.ladder_buys_enabled\": bool(base[\"trailing_stop\"].get(\"ladder_buys\")),\n        \"position_size_usd\": base.get(\"analyze\", {}).get(\"max_position_usd\", 10000),\n        # No live equivalent today — the investigation's strongest finding was that\n        # post-migration losses cluster in thin, sub-$20 micro-caps, so this is\n        # swept from 0 (no filter, matching current behavior) upward.\n        \"min_entry_price\": 0,\n        \"trend_filter_sma_days\": base.get(\"analyze\", {}).get(\"trend_filter_sma_days\", 0),\n        \"sec_insiders.min_transaction_value\": base[\"sec_insiders\"][\"min_transaction_value\"],\n        \"sec_insiders.require_high_conviction\": base[\"sec_insiders\"][\"require_high_conviction\"],\n        \"wheel.put_otm_pct\": base[\"wheel\"][\"put_otm_pct\"],\n        \"wheel.call_otm_pct\": base[\"wheel\"][\"call_otm_pct\"],\n        \"wheel.profit_close_pct\": base[\"wheel\"][\"profit_close_pct\"],\n        \"wheel.weeks_to_expiry\": base[\"wheel\"][\"weeks_to_expiry\"],\n    }\n\n\ndef candidate_to_cfgs(candidate: dict) -> tuple[dict, dict, float]:\n    ts_cfg = {\n        \"initial_stop_pct\": candidate[\"trailing_stop.initial_stop_pct\"],\n        \"trailing_pct\": candidate[\"trailing_stop.trailing_pct\"],\n        \"take_profit_pct\": candidate[\"trailing_stop.take_profit_pct\"],\n        \"profit_target_pct\": candidate[\"trailing_stop.profit_target_pct\"],\n        \"trailing_pct_from_profit\": candidate[\"trailing_stop.trailing_pct\"],\n        \"ladder_buys\": LADDER_BUYS_DEFAULT if candidate[\"trailing_stop.ladder_buys_enabled\"] else [],\n    }\n    wheel_cfg = {\n        \"put_otm_pct\": candidate[\"wheel.put_otm_pct\"],\n        \"call_otm_pct\": candidate[\"wheel.call_otm_pct\"],\n        \"profit_close_pct\": candidate[\"wheel.profit_close_pct\"],\n        \"weeks_to_expiry\": candidate[\"wheel.weeks_to_expiry\"],\n    }\n    return ts_cfg, wheel_cfg, candidate[\"position_size_usd\"]\n\n\ndef candidate_diff(candidate: dict, base: dict) -> dict:\n    return {k: v for k, v in candidate.items() if base.get(k) != v}\n\n\n# ── Bar prefetch (once per sweep run — reused across every candidate) ────────\n\ndef _prefetch_bars(keys: list[tuple[str, date]], days_forward: int = 180) -> dict:\n    cache = {}\n    for symbol, start in keys:\n        if (symbol, start) in cache:\n            continue\n        end = min(date.today(), start + timedelta(days=days_forward))\n        try:\n            cache[(symbol, start)] = get_bars_range(symbol, start, end)\n        except Exception:\n            cache[(symbol, start)] = []\n    return cache\n\n\n# ── Per-evidence-source scoring ───────────────────────────────────────────────\n\ndef _score_trailing_stop(positions: list[dict], bars_cache: dict, ts_cfg: dict, position_size_usd: float, min_entry_price: float = 0, sma_bars_cache: dict | None = None, trend_filter_sma_days: int = 0) -> dict:\n    records = []\n    for pos in positions:\n        symbol, start = pos[\"symbol\"], pos[\"first_buy_date\"]\n        entry_price = pos[\"buys\"][0][\"price\"]\n        if entry_price < min_entry_price:\n            continue\n        if trend_filter_sma_days > 0 and sma_bars_cache is not None:\n            sma = sma_as_of(sma_bars_cache.get((symbol, start)), start, trend_filter_sma_days)\n            if sma is not None and entry_price < sma:\n                continue\n        bars = bars_cache.get((symbol, start))\n        if not bars:\n            continue\n        result = simulate_trailing_stop(symbol, start, entry_price, ts_cfg, position_size_usd, bars=bars)\n        if result is None:\n            continue\n        records.append({\n            \"symbol\": symbol, \"pnl\": result[\"pnl_usd\"], \"exit_date\": result[\"exit_date\"],\n            \"exit_reason\": result[\"exit_reason\"], \"is_open\": result[\"is_open\"],\n        })\n    buckets = bucket_by_month(records, \"exit_date\")\n    return {\n        \"records\": records, \"buckets\": buckets,\n        \"worst_month_pnl\": worst_bucket_pnl(buckets),\n        \"total_pnl\": sum(r[\"pnl\"] for r in records),\n        \"n_trades\": len(records),\n        \"all_positive\": all_buckets_positive(buckets),\n    }\n\n\ndef _score_edgar_replay(signals_raw, bars_cache, ts_cfg, position_size_usd, min_transaction_value, require_high_conviction, min_entry_price: float = 0, sma_bars_cache: dict | None = None, trend_filter_sma_days: int = 0) -> dict | None:\n    if not signals_raw:\n        return None\n    filtered = filter_signals(signals_raw, min_transaction_value, require_high_conviction)\n    records = []\n    for sig in filtered:\n        symbol = sig[\"asset\"][\"ticker\"]\n        try:\n            # publishedDate (filing date) is when the bot could actually see this\n            # signal — txDate is the insider's own transaction date, which can be\n            # up to 2 business days earlier. Entry price also comes from real\n            # market bars, never the Form 4-reported per-share price: the bot\n            # always buys at the current market price via market_buy(), and an\n            # insider's reported price can reflect a negotiated/restricted-stock\n            # price wildly different from the market (confirmed empirically —\n            # e.g. one filing reported $0.80 for a stock trading at $13.28).\n            entry_date = date.fromisoformat(sig[\"publishedDate\"])\n        except (ValueError, KeyError):\n            continue\n        bars = bars_cache.get((symbol, entry_date))\n        if not bars:\n            continue\n        entry_price = float(bars[0].close)\n        if entry_price < max(min_entry_price, 0.01):\n            continue\n        if trend_filter_sma_days > 0 and sma_bars_cache is not None:\n            sma = sma_as_of(sma_bars_cache.get((symbol, entry_date)), entry_date, trend_filter_sma_days)\n            if sma is not None and entry_price < sma:\n                continue\n        result = simulate_trailing_stop(symbol, entry_date, entry_price, ts_cfg, position_size_usd, bars=bars)\n        if result is None:\n            continue\n        records.append({\n            \"symbol\": symbol, \"pnl\": result[\"pnl_usd\"], \"exit_date\": result[\"exit_date\"],\n            \"exit_reason\": result[\"exit_reason\"], \"is_open\": result[\"is_open\"],\n        })\n    buckets = bucket_by_month(records, \"exit_date\")\n    return {\n        \"records\": records, \"buckets\": buckets,\n        \"worst_month_pnl\": worst_bucket_pnl(buckets),\n        \"total_pnl\": sum(r[\"pnl\"] for r in records),\n        \"n_trades\": len(records),\n        \"all_positive\": all_buckets_positive(buckets),\n        \"n_filtered_from\": len(signals_raw),\n    }\n\n\ndef _score_wheel(universe: list[tuple[str, date]], bars_cache: dict, wheel_cfg: dict) -> dict:\n    records = []\n    for symbol, start in universe:\n        bars = bars_cache.get((symbol, start))\n        result = simulate_wheel_cycle(symbol, start, wheel_cfg, bars=bars)\n        for c in result[\"cycles\"]:\n            records.append({\"symbol\": symbol, \"pnl\": c[\"pnl\"], \"exit_date\": c[\"date\"]})\n    buckets = bucket_by_month(records, \"exit_date\")\n    return {\n        \"records\": records, \"buckets\": buckets,\n        \"worst_month_pnl\": worst_bucket_pnl(buckets),\n        \"total_pnl\": sum(r[\"pnl\"] for r in records),\n        \"n_trades\": len(records),\n        \"all_positive\": all_buckets_positive(buckets),\n    }\n\n\n# ── Sweep driver ───────────────────────────────────────────────────────────────\n\ndef run_sweep(\n    max_iterations: int = 200,\n    edgar_start: date | None = None,\n    edgar_end: date | None = None,\n    use_edgar_cache: bool = True,\n    seed: int = 42,\n    target_passing: int = 3,\n    progress_cb=None,\n) -> dict:\n    rng = random.Random(seed)\n    base = _load_base_config()\n    current = candidate_from_base(base)\n\n    positions = [p for p in build_positions(parse_trades_log()) if p[\"buys\"]]\n\n    bars_cache = _prefetch_bars([(p[\"symbol\"], p[\"first_buy_date\"]) for p in positions])\n    sma_keys = [(p[\"symbol\"], p[\"first_buy_date\"]) for p in positions]\n\n    signals_raw = []\n    edgar_bars_cache = {}\n    if edgar_start and edgar_end:\n        signals_raw = fetch_historical_insider_signals(edgar_start, edgar_end, use_cache=use_edgar_cache)\n        # Prefetch bars for the loosest possible filter so every candidate's\n        # (tighter) filtered subset is already covered by the cache.\n        loosest = filter_signals(signals_raw, min_transaction_value=50_000, require_high_conviction=False)\n        keys = []\n        for sig in loosest:\n            try:\n                keys.append((sig[\"asset\"][\"ticker\"], date.fromisoformat(sig[\"publishedDate\"])))\n            except (ValueError, KeyError):\n                continue\n        edgar_bars_cache = _prefetch_bars(keys)\n        sma_keys += keys\n\n    # One SMA bar-window prefetch (up to the largest trend_filter_sma_days in the\n    # grid) covers every candidate's smaller-window SMA too — sliced from the same cache.\n    sma_bars_cache = prefetch_sma_bars(sma_keys)\n\n    wheel_universe = list({(p[\"symbol\"], p[\"first_buy_date\"]) for p in positions})\n    wheel_bars_cache = _prefetch_bars(wheel_universe, days_forward=120)\n\n    def evaluate(candidate: dict) -> dict:\n        ts_cfg, wheel_cfg, pos_size = candidate_to_cfgs(candidate)\n        min_entry_price = candidate[\"min_entry_price\"]\n        trend_filter_sma_days = candidate[\"trend_filter_sma_days\"]\n        real_result = _score_trailing_stop(\n            positions, bars_cache, ts_cfg, pos_size, min_entry_price,\n            sma_bars_cache, trend_filter_sma_days,\n        )\n        edgar_result = _score_edgar_replay(\n            signals_raw, edgar_bars_cache, ts_cfg, pos_size,\n            candidate[\"sec_insiders.min_transaction_value\"],\n            candidate[\"sec_insiders.require_high_conviction\"],\n            min_entry_price, sma_bars_cache, trend_filter_sma_days,\n        )\n        wheel_result = _score_wheel(wheel_universe, wheel_bars_cache, wheel_cfg)\n\n        passes_strict = real_result[\"all_positive\"] and (edgar_result is None or edgar_result[\"all_positive\"])\n        return {\n            \"candidate\": dict(candidate),\n            \"real_trades\": real_result,\n            \"edgar_replay\": edgar_result,\n            \"wheel_estimate\": wheel_result,\n            \"score\": (real_result[\"worst_month_pnl\"], real_result[\"total_pnl\"]),\n            \"passes_strict\": passes_strict,\n        }\n\n    best = evaluate(current)\n    all_results = [best]\n    passing = [best] if best[\"passes_strict\"] else []\n\n    axes = list(PARAM_GRID.keys())\n    iterations = 0\n    while iterations < max_iterations and len(passing) < target_passing:\n        axis = rng.choice(axes)\n        trial = dict(current)\n        trial[axis] = rng.choice(PARAM_GRID[axis])\n        iterations += 1\n        if trial == current:\n            continue\n\n        result = evaluate(trial)\n        all_results.append(result)\n\n        if result[\"score\"] > best[\"score\"]:\n            best = result\n            current = trial\n        if result[\"passes_strict\"]:\n            passing.append(result)\n\n        if progress_cb:\n            progress_cb(iterations, max_iterations, best, len(passing))\n\n    all_results.sort(key=lambda r: r[\"score\"], reverse=True)\n    return {\n        \"iterations\": iterations,\n        \"best\": best,\n        \"passing\": passing,\n        \"leaderboard\": all_results[:20],\n        \"base_candidate\": candidate_from_base(base),\n        \"n_real_positions\": len(positions),\n        \"n_edgar_signals\": len(signals_raw),\n    }\n\n\nif __name__ == \"__main__\":\n    import argparse\n\n    from backtest.report import generate_leaderboard\n\n    parser = argparse.ArgumentParser(description=\"Run the strategy parameter sweep.\")\n    parser.add_argument(\"--iterations\", type=int, default=200)\n    parser.add_argument(\"--edgar-days\", type=int, default=0, help=\"Also replay this many days of historical EDGAR signals (0 = skip)\")\n    parser.add_argument(\"--edgar-end\", type=str, default=None, help=\"YYYY-MM-DD, defaults to today\")\n    parser.add_argument(\"--no-cache\", action=\"store_true\", help=\"Force a fresh EDGAR fetch instead of using backtest/cache/\")\n    parser.add_argument(\"--label\", type=str, default=None, help=\"Label for the output leaderboard/json filenames\")\n    args = parser.parse_args()\n\n    def _progress(i, total, best, n_passing):\n        if i % 10 == 0 or i == total:\n            print(f\"  [{i}/{total}] best worst-month=${best['score'][0]:,.0f} total=${best['score'][1]:,.0f} passing={n_passing}\")\n\n    edgar_start = edgar_end = None\n    if args.edgar_days > 0:\n        edgar_end = date.fromisoformat(args.edgar_end) if args.edgar_end else date.today()\n        edgar_start = edgar_end - timedelta(days=args.edgar_days)\n        print(f\"Will replay historical EDGAR signals {edgar_start} .. {edgar_end}\")\n\n    print(f\"Running parameter sweep (max {args.iterations} iterations)...\")\n    result = run_sweep(\n        max_iterations=args.iterations,\n        edgar_start=edgar_start,\n        edgar_end=edgar_end,\n        use_edgar_cache=not args.no_cache,\n        progress_cb=_progress,\n    )\n    print(f\"\\nDone. {result['iterations']} iterations, {len(result['passing'])} fully-passing candidates found.\")\n    print(f\"Best worst-month P&L: ${result['best']['score'][0]:,.0f} | total: ${result['best']['score'][1]:,.0f}\")\n\n    md_path, json_path = generate_leaderboard(result, label=args.label)\n    print(f\"\\nLeaderboard: {md_path}\")\n    print(f\"Raw results: {json_path}\")\n","numLines":353,"startLine":1,"totalLines":353}}}
